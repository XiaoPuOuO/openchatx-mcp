{
  "name": "openchatx-mcp",
  "version": "0.2.0",
  "private": false,
  "description": "Local MCP platform for ChatGPT with toolboxes, persistent local tools, skills, and MCP aggregation.",
  "homepage": "https://github.com/XiaoPuOuO/openchatx-mcp#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/XiaoPuOuO/openchatx-mcp.git"
  },
  "license": "MIT",
  "type": "module",
  "exports": {
    "./toolbox": "./dist/toolbox/tool.js",
    "./toolbox/toolbox": "./dist/toolbox/toolbox.js"
  },
  "scripts": {
    "auth:reset": "node --import tsx src/auth/reset.ts",
    "build": "rm -rf dist && tsc -p tsconfig.build.json",
    "dev": "node --import tsx --watch src/index.ts",
    "format": "biome format --write .",
    "inspect": "npx @modelcontextprotocol/inspector",
    "postinstall": "node scripts/fix-node-pty-permissions.mjs",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "logs": "node --import tsx scripts/pm2.ts logs",
    "pm2": "node --import tsx scripts/pm2.ts",
    "preflight": "node --import tsx scripts/preflight.ts",
    "print-url": "node --import tsx scripts/print-url.ts",
    "prompt": "node --import tsx scripts/print-start-prompt.ts",
    "restart": "node --import tsx scripts/start.ts --restart",
    "schemas": "node --import tsx scripts/tool-schemas.ts",
    "setup": "node --import tsx scripts/setup.ts",
    "start": "node --import tsx scripts/start.ts",
    "status": "node --import tsx scripts/pm2.ts status",
    "stop": "node --import tsx scripts/pm2.ts stop ecosystem.config.cjs",
    "test": "tsx --test",
    "tunnel": "node --import tsx scripts/pm2.ts startOrReload ecosystem.config.cjs --only openchatx-ngrok --update-env",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "ui:build": "npm --prefix ui run build",
    "ui:dev": "npm --prefix ui run dev",
    "ui:install": "npm --prefix ui ci",
    "vendor:apply-patch": "scripts/vendor/build-apply-patch.sh"
  },
  "overrides": {
    "pm2": {
      "js-yaml": "5.2.3"
    }
  },
  "dependencies": {
    "@modelcontextprotocol/client": "2.0.0",
    "@modelcontextprotocol/express": "2.0.0",
    "@modelcontextprotocol/node": "2.0.0",
    "@modelcontextprotocol/server": "2.0.0",
    "cloakbrowser": "^0.5.9",
    "express": "^5.2.1",
    "js-yaml": "5.2.3",
    "linkedom": "^0.18.13",
    "node-html-markdown": "^2.0.0",
    "node-pty": "^1.1.0",
    "playwright-core": "^1.63.0",
    "pm2": "^7.0.4",
    "sharp": "^0.35.3",
    "smol-toml": "^1.9.0",
    "tiktoken": "^1.0.22",
    "unpdf": "1.8.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.14",
    "@types/express": "^5.0.6",
    "@types/node": "22.18.13",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  },
  "engines": {
    "node": ">=22.18.0"
  },
  "os": [
    "darwin"
  ],
  "cpu": [
    "arm64",
    "x64"
  ],
  "allowScripts": {
    "esbuild@0.28.2": true,
    "fsevents@2.3.3": true,
    "node-pty@1.1.0": true
  }
}
