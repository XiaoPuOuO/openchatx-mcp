{
  "name": "shellby-mcp",
  "version": "0.1.0",
  "description": "Context-optimized agent harness that gives ChatGPT Web full computer access, persistent tools, and multi-agent capabilities.",
  "private": false,
  "license": "MIT",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Serbyte-Development/shellby-mcp.git"
  },
  "homepage": "https://github.com/Serbyte-Development/shellby-mcp#readme",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "build": "rm -rf dist && tsc -p tsconfig.build.json",
    "dev": "node --env-file-if-exists=.env --import tsx --watch src/index.ts",
    "preflight": "node --env-file-if-exists=.env scripts/preflight.mjs",
    "setup": "node --env-file-if-exists=.env scripts/setup.mjs",
    "setup:computer": "node --env-file-if-exists=.env scripts/peekaboo-permissions.mjs",
    "setup:chatgpt": "node --env-file-if-exists=.env scripts/chatgpt-browser.mjs --setup",
    "chatgpt": "node --env-file-if-exists=.env scripts/chatgpt-browser.mjs",
    "start": "node --env-file-if-exists=.env scripts/start.mjs",
    "restart": "node --env-file-if-exists=.env scripts/start.mjs --restart",
    "stop": "pm2 stop ecosystem.config.cjs",
    "status": "pm2 status",
    "logs": "pm2 logs",
    "print-url": "node --env-file-if-exists=.env scripts/print-url.mjs",
    "schemas": "node --env-file-if-exists=.env --import tsx scripts/tool-schemas.ts",
    "inspect": "npx @modelcontextprotocol/inspector",
    "tunnel": "ngrok http 3333 ${NGROK_URL:+--url=\"$NGROK_URL\"} --traffic-policy-file ./ngrok-traffic-policy.yml --inspect=false",
    "auth:reset": "node --env-file-if-exists=.env --import tsx src/auth/reset.ts",
    "reset-agents": "node scripts/reset-agents.mjs",
    "test": "tsx --test test/*.test.ts",
    "test:live:subagent": "RUN_LIVE_SUBAGENT_TESTS=1 tsx --test test/live/subagent-live.test.ts",
    "type-check": "tsc -p tsconfig.json --noEmit",
    "vendor:apply-patch": "scripts/build-apply-patch.sh",
    "vendor:peekaboo": "scripts/build-peekaboo.sh",
    "lint": "eslint src test",
    "lint:fix": "eslint src test --fix",
    "format": "prettier --write src test scripts package.json tsconfig.json tsconfig.build.json eslint.config.js ecosystem.config.cjs"
  },
  "dependencies": {
    "@modelcontextprotocol/client": "2.0.0",
    "@modelcontextprotocol/express": "2.0.0",
    "@modelcontextprotocol/node": "2.0.0",
    "@modelcontextprotocol/server": "2.0.0",
    "cloakbrowser": "^0.5.9",
    "express": "^5.2.1",
    "linkedom": "^0.18.13",
    "node-html-markdown": "^2.0.0",
    "playwright-core": "^1.62.1",
    "pm2": "7.0.3",
    "sharp": "^0.35.3",
    "tiktoken": "^1.0.22",
    "unpdf": "1.8.1",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/express": "^5.0.6",
    "@types/node": "^26.2.0",
    "eslint": "10.8.1",
    "eslint-config-prettier": "10.1.8",
    "prettier": "^3.9.6",
    "tsx": "^4.23.12",
    "typescript": "6.0.3",
    "typescript-eslint": "^8.67.0"
  },
  "overrides": {
    "pm2": {
      "js-yaml": "5.2.3"
    }
  },
  "os": [
    "darwin"
  ],
  "cpu": [
    "arm64",
    "x64"
  ]
}
